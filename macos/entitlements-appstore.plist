<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build (make fyne-ui-macos-appstore-pkg): the App
         Sandbox, which the store requires, and what Mercury needs inside it.
         The application and team identifiers are added from the provisioning
         profile at signing time.  The Developer ID build keeps
         entitlements.plist. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The radio's receive audio. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- CM108 USB HID PTT (hidapi) and Hamlib's user-space USB serial. -->
    <key>com.apple.security.device.usb</key>
    <true/>

    <!-- Hamlib CAT and PTT over a serial port (/dev/cu.*). -->
    <key>com.apple.security.device.serial</key>
    <true/>

    <!-- The TNC ports (8300/8301) and the other ports applications
         connect to. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- rigctld/flrig over the network. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Files: the file to broadcast and the folder for received files are
         picked in the system's open panel (picker_macos.m), the folder is
         kept across restarts by its bookmark, and received files go to
         Downloads until the operator picks a folder.  Without these the
         sandbox leaves the app only its container, which the user cannot
         see (App Review, guideline 2.4.5(i)). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
