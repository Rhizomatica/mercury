# Built fuzz target binaries (anchored to this directory to avoid matching
# corpus/fuzz_*/  and regressions/fuzz_*/ path components)
/fuzz_arq_hdr
/fuzz_frame_header
/fuzz_kiss
/fuzz_arith
/fuzz_ws_json
# libFuzzer artifacts (also anchored)
/crash-*
/leak-*
/oom-*
/timeout-*
# Per-target reproducer dirs written by the CI fuzz loop (-artifact_prefix)
/out/
# Smoke-run finds (make check) and the CI corpus merge: kept out of corpus/
/.check-corpus/
/merged/
*.profraw
# macOS debug symbol bundles
*.dSYM/
