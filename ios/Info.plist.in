<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>org.rhizomatica.mercury</string>
	<key>CFBundleExecutable</key>
	<string>Mercury</string>
	<key>CFBundleName</key>
	<string>Mercury</string>
	<key>CFBundleDisplayName</key>
	<string>Mercury</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>@PLATFORM@</string>
	</array>
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mercury needs access to the radio audio to listen for data signals</string>
	<!-- The modem listens all the time; this keeps it running with the screen
	     off or another app in front, as on any other platform. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The TNC and UI ports are local-network servers. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mercury serves its TNC and web UI to applications on this device and your local network</string>
</dict>
</plist>
